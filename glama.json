{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "avikoren"
  ],
  "baseImage": "debian:trixie-slim",
  "buildSteps": [
    "apt-get update && apt-get install -y --no-install-recommends python3 python3-venv",
    "python3 -m venv /opt/mdp",
    "/opt/mdp/bin/pip install --no-cache-dir mdpipeline"
  ],
  "cmdArguments": [
    "mcp-proxy",
    "--",
    "/opt/mdp/bin/mdpipeline",
    "--install-method",
    "registry",
    "mcp"
  ]
}
